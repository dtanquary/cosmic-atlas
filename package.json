{
  "name": "cosmic-atlas",
  "version": "0.1.0",
  "description": "A clean, interactive 3D atlas of over 14 million galaxy observations.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/check-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "tsc --noEmit && node scripts/build-pages.mjs",
    "preview:pages": "vite preview --host 127.0.0.1 --outDir dist-pages",
    "pages:create": "node scripts/deploy-pages.mjs --create",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "release:audit": "node scripts/check-public-repo.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "test": "vitest run",
    "test:data": "uv run python scripts/test_data.py",
    "test:models": "uv run python scripts/test_model_catalog.py",
    "data:models": "uv run python scripts/prepare_model_catalog.py",
    "data:bootstrap": "uv run python scripts/prepare_data.py --bootstrap --out public/data/bootstrap --activate",
    "data:download": "uv run python scripts/download_catalog.py",
    "data:prepare": "uv run python scripts/prepare_data.py --emit-development --activate"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
